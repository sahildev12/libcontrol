# Add or merge into production .env on libcontrol.phenomit.com (hub server).
# Serves libcontrol-website/ at https://libcontrol.phenomit.com/ (not the library Study Hub site).

LIBCONTROL_MARKETING_SITE_ENABLED=true
LIBCONTROL_MARKETING_SITE_HOSTS=libcontrol.phenomit.com

# After editing .env:
# php artisan config:clear
# php artisan config:cache
# php artisan route:cache
