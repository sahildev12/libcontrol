# Copy to deploy/mail.env (gitignored) before running scripts/deploy-libcontrol-in.ps1
# Hostinger mailbox for LibControl / Katsindia (demo + hub use the same file on server).

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@libcontrol.in
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM_ADDRESS=support@libcontrol.in
MAIL_FROM_NAME=LibControl
